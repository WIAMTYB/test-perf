# Copy to .env (git-ignored). The harness and the simulations read this file themselves;
# never `source` it, the DB password contains '$'.
PERF_ENV=recette

# Client API key authorized on /xcastrade/**, /position/**, /secaccount/**, /tradableasset/**
# and POST /cash/balances (format: <Token ID>.<Secret>, see docs/exploitation.md)
PERF_API_KEY=ak_....

# API key authorized on GET /actuator/prometheus only, used by the metrics sampler
PERF_METRICS_API_KEY=ak_....

# CUSTPPRD account for the post-run analysis (read) and cleanup (delete)
PERF_DB_USER=...
PERF_DB_PASSWORD=...

# Optional: OpenShift context name if the current `oc` context is not the target cluster
# PERF_OC_CONTEXT=
